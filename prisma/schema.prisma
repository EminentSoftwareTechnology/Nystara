generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

/// Encrypted fields hold AES-256-GCM ciphertext (lib/field-encryption.ts); the Prisma client encrypts and decrypts them.
/// email is ciphertext, so its unique index is nominal: lookups by email are rewritten to the keyed emailHash.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailHash        String?   @unique
  emailVerified    DateTime?
  image            String?
  name             String?
  username         String?   @unique
  bio              String?
  avatarUrl        String?
  role             UserRole  @default(USER)
  passwordHash     String?
  sessionVersion   Int       @default(0)
  createdAt        DateTime  @default(now())
  stripeCustomerId String?   @unique
  emailTheme       String    @default("light")
  activityEmails   Boolean   @default(true)
  isSynthetic      Boolean   @default(false)
  mfaEnabled       Boolean   @default(false)
  totpSecret       String?
  totpEnabledAt    DateTime?
  totpLastStep     Int?
  readingHistoryClearedAt DateTime?

  readingLists    ReadingList[]
  savedLists      SavedList[]
  highlights      Highlight[]
  topicFollows    TopicFollow[]
  aiConversations AiConversation[]
  digest          Subscriber?

  accounts      Account[]
  sessions      Session[]
  articles      Article[]
  comments      Comment[]
  claps         Clap[]
  bookmarks     Bookmark[]
  feedback      ArticleFeedback[]
  following     Follow[]          @relation("follower")
  followers     Follow[]          @relation("following")
  subscription  Subscription?
  passkeys      Passkey[]
  recoveryCodes RecoveryCode[]
}

model Article {
  id          String    @id @default(cuid())
  slug        String
  title       String
  subtitle    String?
  coverImage  String?
  content     Json
  contentText String
  readTime    Int
  published   Boolean   @default(false)
  memberOnly  Boolean   @default(false)
  publishedAt DateTime?
  theme       String    @default("classic")
  scheduledAt DateTime?
  unlisted    Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  tags       ArticleTag[]
  comments   Comment[]
  claps      Clap[]
  bookmarks  Bookmark[]
  views      ArticleView[]
  feedback   ArticleFeedback[]
  listItems  ReadingListItem[]
  highlights Highlight[]

  @@unique([authorId, slug])
  @@index([published, publishedAt])
  @@index([authorId, published, publishedAt])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  articles  ArticleTag[]
  followers TopicFollow[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  /// Display name for guest comments; null when authorId is set.
  guestName String?

  authorId  String?
  articleId String
  parentId  String?

  author  User?     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("replies")

  @@index([articleId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model Clap {
  userId    String
  articleId String
  count     Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

model Bookmark {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  visitorId String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
  @@index([articleId])
  @@index([createdAt])
}

enum Reaction {
  LIKE
  DISLIKE
}

/// One like/dislike and star rating per reader. voterId is the user id or the signed anonymous reader id.
model ArticleFeedback {
  articleId String
  voterId   String
  userId    String?
  reaction  Reaction?
  rating    Int?
  updatedAt DateTime  @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, voterId])
  @@index([userId])
  @@index([updatedAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               SubStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime
  mfaVerifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier     String
  identifierHash String?
  token          String   @unique
  expires        DateTime

  @@index([identifierHash])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String
  backedUp     Boolean
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use WebAuthn challenges. Rows are deleted when consumed or by the retention cleanup.
model AuthChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  purpose   String
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
}

model ReadingList {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ReadingListItem[]
  saves       SavedList[]

  @@index([userId])
}

model ReadingListItem {
  listId    String
  articleId String
  createdAt DateTime    @default(now())
  list      ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([listId, articleId])
  @@index([articleId])
}

model SavedList {
  userId    String
  listId    String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
  @@index([listId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  quote     String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([articleId])
}

model TopicFollow {
  userId    String
  tagId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  attachments    Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum DigestFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Digest email subscription. Visitors confirm by email (confirmedAt); signed-in members are linked by userId.
model Subscriber {
  id          String          @id @default(cuid())
  email       String          @unique
  emailHash   String?         @unique
  frequency   DigestFrequency @default(WEEKLY)
  userId      String?         @unique
  confirmedAt DateTime?
  lastSentAt  DateTime?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([frequency, confirmedAt])
}
