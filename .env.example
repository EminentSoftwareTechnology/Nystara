# Database — Railway provides this automatically when you link the Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis is required in production for atomic limits shared across replicas.
REDIS_URL=redis://127.0.0.1:6379

# Enable only when the ingress appends/overwrites X-Forwarded-For and direct access is blocked.
TRUST_PROXY_IP=0

# Local full-stack Compose password (use a random hex value).
POSTGRES_PASSWORD=

# NextAuth
NEXTAUTH_URL=http://localhost:6000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Local app port
PORT=6000

# Separate admin signing secret (required, minimum 32 random characters)
ADMIN_JWT_SECRET=generate-with-openssl-rand-base64-32

# Encrypts authenticator-app (TOTP) secrets at rest: 32 random bytes, base64 (openssl rand -base64 32).
# Changing it breaks existing authenticator-app enrolments; users would fall back to passkeys or recovery codes.
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Admin seed credentials (used by prisma db seed). Use a unique password of 12+ chars.
ADMIN_EMAIL=admin@nystara.com
ADMIN_PASSWORD=

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — github.com/settings/apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend — resend.com/api-keys
RESEND_API_KEY=

# Local development email capture (Mailpit)
EMAIL_SERVER=smtp://127.0.0.1:1025
EMAIL_FROM=Nystara <noreply@nystara.local>

# Cloudflare Turnstile — dash.cloudflare.com/turnstile
# Configure real keys in production. The development widget defaults to the documented test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob — vercel.com/storage
BLOB_READ_WRITE_TOKEN=
