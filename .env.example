# Database — Railway provides this automatically when you link the Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Admin JWT secret (falls back to NEXTAUTH_SECRET if not set)
ADMIN_JWT_SECRET=generate-with-openssl-rand-base64-32

# Admin seed credentials (used by prisma db seed). Use a unique password of 12+ chars.
ADMIN_EMAIL=admin@techscribe.io
ADMIN_PASSWORD=

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — github.com/settings/apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend — resend.com/api-keys
RESEND_API_KEY=

# Cloudflare Turnstile — dash.cloudflare.com/turnstile
# Test keys (always pass) — replace with real keys in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Stripe — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob — vercel.com/storage
BLOB_READ_WRITE_TOKEN=
