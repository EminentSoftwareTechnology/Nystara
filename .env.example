# Database — Railway provides this automatically when you link the Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis is required in production for atomic limits shared across replicas.
REDIS_URL=redis://127.0.0.1:6389

# Enable only when the ingress appends/overwrites X-Forwarded-For and direct access is blocked.
TRUST_PROXY_IP=0

# Local full-stack Compose password (use a random hex value).
POSTGRES_PASSWORD=

# NextAuth
NEXTAUTH_URL=http://localhost:6100
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Local app port
PORT=6100

# Separate admin signing secret (required, minimum 32 random characters)
ADMIN_JWT_SECRET=generate-with-openssl-rand-base64-32

# Encrypts authenticator-app (TOTP) secrets at rest: 32 random bytes, base64 (openssl rand -base64 32).
# Changing it breaks existing authenticator-app enrolments; users would fall back to passkeys or recovery codes.
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Encrypts personal data columns (emails, OAuth tokens, highlights, AI chats): 32 random bytes, base64.
# Required. Back it up: losing or changing it makes every encrypted value unreadable.
DATA_ENCRYPTION_KEY=

# Admin seed credentials (used by prisma db seed). Use a unique password of 12+ chars.
ADMIN_EMAIL=admin@nystara.com
ADMIN_PASSWORD=

# Google OAuth — register exact /api/auth/callback/google URLs; see DEPLOY.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (not a personal access token); see DEPLOY.md for setup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend is the default in local development, staging and production.
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=Nystara <noreply@nystara.com>

# Optional offline email capture: EMAIL_PROVIDER=smtp (development only).
EMAIL_SERVER=smtp://127.0.0.1:1035

# Cloudflare Turnstile — dash.cloudflare.com/turnstile
# Configure real keys in production. The development widget defaults to the documented test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob — vercel.com/storage
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 — bucket-scoped Object Read & Write credentials, server only.
# Public URL must be the exact HTTPS custom-domain or r2.dev base URL from Cloudflare.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional clamd (ClamAV daemon) for upload virus scanning. When set, uploads fail closed if clamd is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Premium AI editor — Responses API model ID available to your OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=

# Enable the newsroom on production or non-loopback databases. Leave unset for ordinary local use.
NEWSROOM_ENABLED=

# Optional newsroom model override; needs web_search + structured outputs.
# Defaults to OPENAI_MODEL, then gpt-4.1-mini. Each daily run generates up to 250 long articles.
NEWSROOM_OPENAI_MODEL=
