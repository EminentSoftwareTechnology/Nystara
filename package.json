{
  "name": "nystara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node --env-file-if-exists=.env.local --import tsx prisma/demo-seed.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:integration": "node --import tsx --test tests/*.integration.ts",
    "typecheck": "tsc --noEmit",
    "email:preview": "node --import tsx scripts/preview-emails.mts",
    "db:cleanup": "node --import tsx scripts/cleanup.ts",
    "db:encrypt": "node --import tsx scripts/encrypt-existing.ts",
    "digests": "node --import tsx scripts/send-digests.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@next/env": "^16.4.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@stripe/stripe-js": "^9.4.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.1.1",
    "redis": "^6.3.0",
    "resend": "^6.12.3",
    "sharp": "^0.35.5",
    "stripe": "^22.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "@simplewebauthn/server": "$@simplewebauthn/server",
    "@simplewebauthn/browser": "$@simplewebauthn/browser"
  }
}
