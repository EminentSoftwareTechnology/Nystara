FROM node:22-alpine
RUN apk add --no-cache libc6-compat font-dejavu
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json ./
COPY lib ./lib
COPY scripts/daily-newsroom.mts scripts/cleanup.ts ./scripts/
RUN npx prisma generate
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 newsroom && chown -R newsroom:nodejs /app
USER newsroom
CMD ["node", "--import", "tsx", "scripts/daily-newsroom.mts"]
